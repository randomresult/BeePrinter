TZ=Europe/Berlin

# Admin-Login (Hash erzeugen: npm run admin:hash -- 'meinPasswort')
NUXT_ADMIN_EMAIL=admin@example.org
NUXT_ADMIN_PASSWORD_HASH=

# Session-Schlüssel (openssl rand -base64 32)
NUXT_APP_SECRET=

NUXT_DATABASE_PATH=.data/db.sqlite
NUXT_DATEIEN_DIR=.data/dateien
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Testmodus: sk_test_…). Leer = Zahlung wird im Dev-Modus simuliert.
NUXT_STRIPE_SECRET_KEY=
# Lokal: stripe listen --forward-to localhost:3000/api/stripe/webhook
NUXT_STRIPE_WEBHOOK_SECRET=

# SMTP (lokal: Mailpit, docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit)
NUXT_MAIL_FROM="BeePrinter <etiketten@example.org>"
NUXT_SMTP_HOST=localhost
NUXT_SMTP_PORT=1025
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=

NUXT_TRUST_PROXY=false
